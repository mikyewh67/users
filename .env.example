# Supabase (server-only)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Telegram (server-only)
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_PRIVATE_CHAT_ID

# Admin + fulfillment email (server-only)
ADMIN_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_YOUR_KEY
FROM_EMAIL=HandleVault <orders@yourdomain.com>

# Public payment destinations (these are intentionally shown at checkout)
CASHAPP_TAG=$yourcashtag
ZELLE_TO=you@example.com
ZELLE_NAME=Your Name
PAYPAL_TO=you@example.com
CRYPTO_NETWORK=BTC
CRYPTO_ADDRESS=YOUR_WALLET_ADDRESS
